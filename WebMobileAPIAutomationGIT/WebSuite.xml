<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TestSuite" parallel="tests" thread-count="5" configfailurepolicy="continue">
    <listeners>
        <listener class-name="com.aventstack.extentreports.testng.listener.ExtentIReporterSuiteClassListenerAdapter"/>
        <listener class-name="org.testng.reporters.EmailableReporter"/>
        <listener class-name="org.testng.reporters.JUnitReportReporter"/>
    </listeners>
    <test name="Bid1">
        <classes>
            <class name="testscripts.webtestcases.WebScripts">
                <methods>
                    <include name="LoginAndSubmitBid1"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Bid2">
        <classes>
            <class name="testscripts.webtestcases.WebScripts">
                <methods>
                    <include name="LoginAndSubmitBid2"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>